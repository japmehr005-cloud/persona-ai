{
  "version": 8,
  "name": "Persona AI FIN Security Canvas",
  "sources": {
    "ne2_shaded": {
      "type": "raster",
      "tiles": ["https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "maxzoom": 6
    },
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#152033"
      }
    },
    {
      "id": "landcover_land",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["in", ["get", "class"], ["literal", ["farmland", "wood", "grass", "scrub", "crop", "ice"]]]
      ],
      "paint": {
        "fill-color": "#1e293b",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.35,
          8,
          0.55,
          12,
          0.65
        ]
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "class"], "wood"]
      ],
      "paint": {
        "fill-color": "#243044",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          0.2,
          10,
          0.4
        ]
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["in", ["get", "class"], ["literal", ["grass", "scrub", "farmland"]]]
      ],
      "paint": {
        "fill-color": "#1f2a3d",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          0.15,
          10,
          0.32
        ]
      }
    },
    {
      "id": "natural_earth",
      "type": "raster",
      "source": "ne2_shaded",
      "maxzoom": 9,
      "paint": {
        "raster-opacity": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          0,
          0.42,
          5,
          0.28,
          7,
          0.16,
          9,
          0.08
        ],
        "raster-saturation": -0.8,
        "raster-contrast": -0.1,
        "raster-brightness-min": 0.06,
        "raster-brightness-max": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {
        "fill-antialias": true,
        "fill-color": "#07101f"
      }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {
        "line-color": "#334155",
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.35,
          8,
          0.55,
          12,
          0.7
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.4,
          10,
          1.1
        ]
      }
    },
    {
      "id": "landcover_ice_shelf",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "maxzoom": 8,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "subclass"], "ice_shelf"]
      ],
      "paint": {
        "fill-color": "#232b3d",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landcover_glacier",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "maxzoom": 8,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "subclass"], "glacier"]
      ],
      "paint": {
        "fill-color": "#232b3d",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "paint": {
        "line-color": "#0c1830",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 12, 1.4],
        "line-opacity": 0.7
      }
    },
    {
      "id": "boundary_state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 4],
        ["!=", ["get", "maritime"], 1]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#64748b",
        "line-dasharray": [2, 2],
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.55,
          7,
          0.85,
          12,
          0.95
        ],
        "line-width": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          3,
          0.7,
          8,
          1.25,
          12,
          1.8
        ]
      }
    },
    {
      "id": "boundary_country_glow",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 2],
        ["!", ["has", "claimed_by"]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#cbd5e1",
        "line-opacity": 0.2,
        "line-blur": 1.8,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2,
          2.5,
          6,
          4,
          10,
          5.5
        ]
      }
    },
    {
      "id": "boundary_country_z0-4",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "maxzoom": 5,
      "filter": [
        "all",
        ["==", ["get", "admin_level"], 2],
        ["!", ["has", "claimed_by"]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#94a3b8",
        "line-opacity": 0.95,
        "line-width": [
          "interpolate",
          ["exponential", 1.1],
          ["zoom"],
          2,
          0.9,
          4,
          1.35,
          5,
          1.6
        ]
      }
    },
    {
      "id": "boundary_country_z5-",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 5,
      "filter": ["==", ["get", "admin_level"], 2],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#94a3b8",
        "line-opacity": 0.95,
        "line-width": [
          "interpolate",
          ["exponential", 1.1],
          ["zoom"],
          5,
          1.4,
          10,
          2.2,
          14,
          3
        ]
      }
    }
  ]
}

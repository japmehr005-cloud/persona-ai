// Persona AI — data model
// Covers the full product architecture (Phases 1-6). Models are grouped by
// the phase that introduces them; earlier phases only read/write their own
// slice of the schema so the product can be demoed incrementally even
// though the schema is created up front.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 1 — Identity & accounts
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ANALYST
  ADMIN
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole @default(CUSTOMER)
  isDemo         Boolean  @default(false)
  // Legacy single-threshold OTP trigger, superseded by UserSettings'
  // mediumRiskThreshold/highRiskThreshold (see Phase 8). Kept in place,
  // unused by new code paths, rather than dropped outright.
  otpThreshold   Int      @default(71)
  // Incremented by "Logout all devices" (see Phase 8); the Auth.js session
  // callback rejects any JWT whose embedded version doesn't match this.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts              Account[]
  behavioralProfile     BehavioralProfile?
  devices               Device[]
  sessions              Session[]
  alerts                Alert[]
  importJobs            ImportJob[]
  auditLogs             AuditLog[]
  contextSignals        ContextSignal[]
  settings              UserSettings?
  twoFactorCredential   TwoFactorCredential?
  webAuthnCredentials   WebAuthnCredential[]
  pendingAuthChallenges PendingAuthChallenge[]
  otpChallenges         OtpChallenge[]

  // Phase 9 — Fraud Intelligence Network
  trustedLocations     TrustedLocation[]
  fraudReportsFiled    FraudReport[]     @relation("FraudReportsFiled")
  fraudReportsResolved FraudReport[]     @relation("FraudReportsResolved")
  finEvents            FinEvent[]

  // Phase 2 AI — Persona Financial Assistant
  assistantThreads AssistantThread[]

  @@map("users")
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mask      String
  type      String   @default("CHECKING")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@map("accounts")
}

// ---------------------------------------------------------------------------
// Phase 2 — Transactions & statement import
// ---------------------------------------------------------------------------

enum TransactionStatus {
  PENDING
  APPROVED
  DENIED
  FLAGGED
  /// Social Engineering Protection interrupted the transfer before completion.
  /// Independent of Risk Engine scoring — see transaction-orchestrator.
  PAUSED_FOR_VERIFICATION
}

enum TransactionChannel {
  CARD
  TRANSFER
  ACH
  ATM
  ONLINE
}

enum ImportJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model ImportJob {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename      String
  status        ImportJobStatus @default(PROCESSING)
  rowCount      Int             @default(0)
  importedCount Int             @default(0)
  errorLog      Json?
  createdAt     DateTime        @default(now())
  completedAt   DateTime?

  transactions Transaction[]

  @@map("import_jobs")
}

model Transaction {
  id          String             @id @default(cuid())
  accountId   String
  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importJobId String?
  importJob   ImportJob?         @relation(fields: [importJobId], references: [id])
  date        DateTime
  amount      Decimal            @db.Decimal(14, 2)
  merchant    String
  category    String
  beneficiary String?
  channel     TransactionChannel @default(CARD)
  status      TransactionStatus  @default(APPROVED)
  isSimulated Boolean            @default(false)
  createdAt   DateTime           @default(now())

  riskAssessment RiskAssessment?
  otpChallenges  OtpChallenge[]
  contextSignals ContextSignal[]
  alerts         Alert[]
  fraudReports   FraudReport[]
  finEvents      FinEvent[]

  @@index([accountId, date])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Phase 3 — Behavioral baseline & device/session history
// ---------------------------------------------------------------------------

model BehavioralProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version      Int      @default(1)
  avgAmount    Decimal  @db.Decimal(14, 2)
  medianAmount Decimal  @db.Decimal(14, 2)
  p95Amount    Decimal  @db.Decimal(14, 2)
  stdDevAmount Decimal  @db.Decimal(14, 2)
  txPerDay     Decimal  @db.Decimal(8, 2)
  topMerchants Json // Array<{ merchant: string; count: number; totalAmount: number }>
  activeHours  Json // 24-slot matrix of relative activity frequency by hour
  activeDays   Json? // 7-slot matrix of relative activity frequency by weekday (Sun=0)
  // Phase 2 AI — category mix + monthly spend distribution for behavioral learning
  categoryFrequency    Json? // Record<string, number> relative frequency by category
  monthlyCategorySpend Json? // Array<{ month: string; categories: Record<string, number> }>
  sampleSize   Int
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("behavioral_profiles")
}

model Device {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprintHash String
  label           String
  userAgent       String?
  trusted         Boolean  @default(false)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  // Phase 9 — richer, multi-signal device intelligence (FIN). `components`
  // is the raw multi-signal snapshot captured client-side; `similarityKey`
  // is a coarse, deliberately IP/browser-version-agnostic hash (platform +
  // timezone + language + screen) so a VPN switch or a minor browser update
  // doesn't mint an entirely new device identity — see
  // services/fin/device-intelligence.ts.
  platform            String?
  screenResolution    String?
  timezone            String?
  language            String?
  hardwareConcurrency Int?
  colorDepth          Int?
  components          Json?
  similarityKey       String?

  sessions     Session[]
  fraudReports FraudReport[]
  finEvents    FinEvent[]

  @@unique([userId, fingerprintHash])
  @@index([similarityKey])
  @@map("devices")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       Device?  @relation(fields: [deviceId], references: [id])
  ipAddress    String?
  userAgent    String?
  city         String?
  region       String?
  country      String?
  latitude     Float?
  longitude    Float?
  // Horizontal accuracy in metres from `navigator.geolocation` when the
  // browser supplied coordinates; null for IP-resolved locations.
  accuracy     Float?
  // Where the lat/long came from — BROWSER is preferred; IP is the
  // graceful fallback when permission is denied or geolocation is unavailable.
  locationSource SessionLocationSource?
  // Phase 9 — populated by services/geolocation once a real-or-mock IP
  // lookup runs; `trusted` mirrors a `TrustedLocation` match, `isSuspicious`
  // is set by Context Intelligence (e.g. impossible travel, new region).
  trusted      Boolean  @default(false)
  isSuspicious Boolean  @default(false)
  startedAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // FIN Enterprise Upgrade — the login-risk snapshot and the authentication
  // method that actually won at sign-in, persisted here (rather than only
  // used transiently in `scoreLogin`) so the Security Map/timeline can show
  // a risk score and auth method per login without recomputing history.
  // Nullable so every session created before this upgrade remains valid.
  riskScore  Int?
  riskTier   RiskTier?
  authMethod SessionAuthMethod?

  fraudReports FraudReport[]
  finEvents    FinEvent[]

  @@map("sessions")
}

enum SessionLocationSource {
  BROWSER
  IP
  UNKNOWN
}

// Distinct from `PreferredAuthMethod` (the customer's *preference*): this
// records what actually happened at a given sign-in, including the
// no-step-up baseline (`PASSWORD_ONLY`) and the legacy TOTP 2FA flow, which
// `PreferredAuthMethod` doesn't cover.
enum SessionAuthMethod {
  PASSWORD_ONLY
  PASSWORD_OTP
  PASSWORD_BIOMETRIC
  AUTHENTICATOR
  TOTP_2FA
}

// ---------------------------------------------------------------------------
// Phase 4 — Adaptive Risk Engine & alerts
// ---------------------------------------------------------------------------

enum RiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Tracks the "context session" a HIGH/CRITICAL assessment opens for the
// High-Risk Verification flow: PENDING while awaiting the customer's
// Cancel/Verify Identity decision, then VERIFIED (proceeded to CB-OTP),
// EXPIRED (session window elapsed), or REJECTED (customer cancelled).
// Stays NONE for LOW/MEDIUM assessments, which never open a session.
enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

model RiskAssessment {
  id                    String             @id @default(cuid())
  transactionId         String             @unique
  transaction           Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  score                 Int
  tier                  RiskTier
  explanation           String
  otpRequired           Boolean            @default(false)
  // Model confidence in this assessment (0-100), derived from behavioral
  // baseline sample size and the number of corroborating factors.
  confidence            Int                @default(70)
  verificationStatus    VerificationStatus @default(NONE)
  verificationExpiresAt DateTime?
  sessionToken          String?
  createdAt             DateTime           @default(now())

  // Snapshot of the behavioral baseline and device-trust signal exactly as
  // they were at scoring time, for the explainability panel (Section 6).
  // Deliberately captured here rather than re-derived later, since the
  // live BehavioralProfile keeps moving forward as new transactions land —
  // an audit/explanation should reflect what the engine actually knew when
  // it made this decision, not what it knows now.
  baselineAvgAmount    Decimal? @db.Decimal(14, 2)
  baselineP95Amount    Decimal? @db.Decimal(14, 2)
  baselineMedianAmount Decimal? @db.Decimal(14, 2)
  baselineSampleSize   Int?
  deviceTrusted        Boolean?

  // Phase 9 — snapshots of the FIN/government-intelligence/device-similarity
  // contribution and the engine's plain-language recommended action, for the
  // explainability panel. Nullable so historical rows remain valid.
  finRiskScore          Int?
  governmentRiskScore   Int?
  deviceSimilarityScore Int?
  // Phase 2 AI — additive Transaction Intelligence contribution snapshot
  aiRiskScore           Int?
  recommendation        String?

  factors RiskFactor[]

  @@map("risk_assessments")
}

model RiskFactor {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  code         String
  label        String
  detail       String
  weight       Int
  contribution Int

  @@map("risk_factors")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AlertDisposition {
  UNREVIEWED
  CONFIRMED_FRAUD
  FALSE_POSITIVE
  ESCALATED
}

model Alert {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction?     @relation(fields: [transactionId], references: [id])
  severity      AlertSeverity
  title         String
  body          String
  status        AlertStatus      @default(OPEN)
  disposition   AlertDisposition @default(UNREVIEWED)
  analystNote   String?
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?

  @@index([userId, status])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// Phase 5 — CB-OTP & simulated context signals
// ---------------------------------------------------------------------------

enum OtpChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

// Phase 9 — lets the same CB-OTP engine issue login-time OTPs (Adaptive
// Authentication Option 1) in addition to transaction step-up OTPs, instead
// of duplicating the challenge/verify logic in a second model.
enum OtpPurpose {
  TRANSACTION
  LOGIN
}

model OtpChallenge {
  id     String @id @default(cuid())
  // Direct owner FK — required so LOGIN-purpose challenges (which have no
  // transaction) can still be scoped to a user. TRANSACTION-purpose
  // challenges keep transactionId as their scoping key as before.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  purpose       OtpPurpose   @default(TRANSACTION)

  contextHash           String
  otpHash               String
  // Binds the challenge to the device that requested it — checked (not just
  // stored) at verify time so a stolen/leaked code can't be redeemed from a
  // different device. Nullable for delivery channels where no fingerprint
  // was available.
  deviceFingerprintHash String?

  attempts    Int                @default(0)
  maxAttempts Int                @default(3)
  status      OtpChallengeStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  verifiedAt  DateTime?

  @@index([userId, purpose])
  @@map("otp_challenges")
}

enum ContextSignalType {
  CALL
  SMS
  LOCATION
  DEVICE
}

model ContextSignal {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction?      @relation(fields: [transactionId], references: [id])
  type          ContextSignalType
  payload       Json
  simulated     Boolean           @default(true)
  receivedAt    DateTime          @default(now())

  @@map("context_signals")
}

// ---------------------------------------------------------------------------
// Phase 6 — Audit trail (admin console)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 8 — Settings, real 2FA/biometric auth, and risk-engine v2 support
// ---------------------------------------------------------------------------

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profile
  phone        String?
  organization String?

  // Security preferences (2FA/biometric enrollment itself lives in
  // TwoFactorCredential/WebAuthnCredential; those tables are the source of
  // truth for "enabled", not a duplicated flag here)
  emailAlertsEnabled Boolean @default(true)
  smsAlertsEnabled   Boolean @default(false)

  // Risk Engine tuning — mirrors and supersedes User.otpThreshold.
  // Server-clamped on write: medium in [10,40], high in [40,79], so a
  // customer can never raise their own threshold into CRITICAL territory.
  adaptiveLearningEnabled Boolean @default(true)
  mediumRiskThreshold     Int     @default(25)
  highRiskThreshold       Int     @default(60)
  riskEngineDemoMode      Boolean @default(false)

  // Developer settings (only surfaced in the UI for demo accounts)
  showRiskDebugPanel Boolean @default(false)

  // Phase 9 — Adaptive Authentication method preference. Nullable and
  // default-less on purpose: a `UserSettings` row is created the moment a
  // customer changes *any* setting (see update-security-preferences.ts
  // etc.), so a non-null default here would silently opt every existing
  // user into an extra login step the first time they touched an unrelated
  // toggle. `null` means "no explicit preference" — password-only login
  // (or the legacy TOTP flow, if already enabled) — see `scoreLogin`.
  // The Risk Engine's login-risk score can still force a stronger method
  // than this preference for a suspicious login; it can never relax below it.
  preferredAuthMethod PreferredAuthMethod?

  // Accessibility / Senior Mode — additive profile layered on the customer UI.
  // Does not replace the default interface; toggled from Settings and an
  // optional first-login modal. uiLocale drives voice + Persona AI language only.
  seniorMode           Boolean  @default(false)
  largeText            Boolean  @default(false)
  highContrast         Boolean  @default(false)
  reducedMotion        Boolean  @default(false)
  voiceResponses       Boolean  @default(false)
  uiLocale             UiLocale @default(EN)
  a11yOnboardingSeen   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

enum PreferredAuthMethod {
  PASSWORD_OTP
  PASSWORD_BIOMETRIC
  AUTHENTICATOR
}

enum UiLocale {
  EN
  HI
  PA
}

model TwoFactorCredential {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret     String
  enabled    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@map("two_factor_credentials")
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  deviceLabel  String
  transports   Json?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@map("webauthn_credentials")
}

enum PendingAuthChallengeKind {
  TOTP_LOGIN
  WEBAUTHN_LOGIN
}

// Short-lived bridge between step 1 (password check) and step 2 (TOTP or
// WebAuthn) of a multi-factor login, so the Credentials provider's
// single-shot authorize() can hand off to a second screen without ever
// establishing a real session until both steps succeed.
model PendingAuthChallenge {
  id        String                   @id @default(cuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String                   @unique
  kind      PendingAuthChallengeKind
  expiresAt DateTime
  consumed  Boolean                  @default(false)
  createdAt DateTime                 @default(now())

  @@map("pending_auth_challenges")
}

// ---------------------------------------------------------------------------
// Phase 9 — Fraud Intelligence Network (FIN) & Government Intelligence
// (FRI/MNRL). Everything below is additive: new tables only, no existing
// model is narrowed or dropped. FIN is a service layer (services/fin/), not
// a page — these tables are its data store, consumed by the Risk Engine,
// the customer Security section, and the Admin Security Operations Center.
// ---------------------------------------------------------------------------

enum TrustedLocationSource {
  SELF_REPORTED
  AUTO_LEARNED
}

// A location a customer has used enough (or explicitly confirmed) that it
// should no longer be treated as anomalous by Context Intelligence. Kept
// separate from `Session` (which records every individual sign-in) since a
// trusted location aggregates many sessions into one reusable signal.
model TrustedLocation {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        String?
  region      String?
  country     String?
  latitude    Float?
  longitude   Float?
  source      TrustedLocationSource @default(AUTO_LEARNED)
  trusted     Boolean               @default(false)
  useCount    Int                   @default(1)
  firstSeenAt DateTime              @default(now())
  lastSeenAt  DateTime              @default(now())

  @@index([userId])
  @@map("trusted_locations")
}

enum FraudReportType {
  SUSPICIOUS_LOGIN
  SUSPICIOUS_TRANSACTION
  SUSPICIOUS_BENEFICIARY
  NOT_ME
}

enum FraudReportStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

// Customer-filed reports ("Report suspicious login/transaction/beneficiary",
// "This wasn't me"). Every report is the seed of a `FinEvent` and can grow
// into a `FraudCluster` once it corroborates with another user's report —
// this is what makes FIN "continuously updating" rather than a one-off form.
model FraudReport {
  id             String            @id @default(cuid())
  reporterUserId String
  reporter       User              @relation("FraudReportsFiled", fields: [reporterUserId], references: [id], onDelete: Cascade)
  type           FraudReportType
  status         FraudReportStatus @default(OPEN)
  description    String?
  // FIN Enterprise Upgrade — defaulted from the report type at creation
  // (see fraud-report-service.ts's REPORT_SEVERITY map) and editable by an
  // analyst from the Fraud Investigation workflow. Nullable so historical
  // reports created before this upgrade remain valid.
  severity       AlertSeverity?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  sessionId     String?
  session       Session?     @relation(fields: [sessionId], references: [id])
  deviceId      String?
  device        Device?      @relation(fields: [deviceId], references: [id])
  beneficiary   String?

  resolvedByUserId String?
  resolvedBy       User?     @relation("FraudReportsResolved", fields: [resolvedByUserId], references: [id])
  resolutionNote   String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  @@index([reporterUserId])
  @@index([status])
  @@map("fraud_reports")
}

// The FIN correlation log — deliberately separate from `AuditLog` (which has
// no severity/category taxonomy and only indexes by entityId) so admin SOC
// queries like "every high-severity event touching this device in the last
// 24h" don't require scanning free-form audit text.
enum FinEventType {
  FRAUD_REPORT_FILED
  FRAUD_REPORT_RESOLVED
  DEVICE_FLAGGED
  DEVICE_TRUSTED
  DEVICE_SIMILARITY_MATCH
  LOGIN_NEW_DEVICE
  LOGIN_NEW_LOCATION
  LOGIN_HIGH_RISK
  LOGIN_STEP_UP_REQUIRED
  LOGIN_STEP_UP_COMPLETED
  MNRL_MATCH
  FRI_HIT
  CLUSTER_CREATED
  CLUSTER_LINKED
  OTP_CONTEXT_MISMATCH
  TRANSACTION_PAUSED_CALL_ACTIVE
  IMPOSSIBLE_TRAVEL_DETECTED
}

model FinEvent {
  id       String        @id @default(cuid())
  type     FinEventType
  severity AlertSeverity

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id])

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id])

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  beneficiary String?
  ipAddress   String?

  summary   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([userId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("fin_events")
}

enum ClusterEntityType {
  USER
  DEVICE
  BENEFICIARY
  IP
}

enum ClusterRiskLevel {
  WATCH
  ELEVATED
  CRITICAL
}

// A group of entities (users/devices/beneficiaries/IPs) linked by shared
// fraud-relevant attributes across ≥2 corroborating fraud reports. Powers
// the Admin SOC relationship graph's "fraud clusters" view.
model FraudCluster {
  id        String           @id @default(cuid())
  label     String
  riskLevel ClusterRiskLevel @default(WATCH)
  summary   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members FraudClusterMember[]

  @@map("fraud_clusters")
}

model FraudClusterMember {
  id          String            @id @default(cuid())
  clusterId   String
  cluster     FraudCluster      @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  entityType  ClusterEntityType
  entityValue String
  addedAt     DateTime          @default(now())

  @@unique([clusterId, entityType, entityValue])
  @@index([entityType, entityValue])
  @@map("fraud_cluster_members")
}

enum GovSource {
  FRI
  MNRL
}

enum GovSubjectType {
  PHONE
  ACCOUNT
  BENEFICIARY
}

enum GovRiskLevel {
  CLEAR
  LOW
  ELEVATED
  HIGH
}

// Cached FRI (Financial Fraud Risk Indicator) / MNRL (Mobile Number
// Revocation List) lookups. Deliberately modeled as a cache in front of a
// `GovernmentIntelligenceProvider` interface (services/government-intelligence)
// so a real government API can replace the mock provider later without any
// caller changing — see services/government-intelligence/provider.ts.
model GovernmentRiskRecord {
  id           String         @id @default(cuid())
  source       GovSource
  subjectType  GovSubjectType
  subjectValue String
  matched      Boolean        @default(false)
  riskLevel    GovRiskLevel   @default(CLEAR)
  details      Json?
  checkedAt    DateTime       @default(now())
  expiresAt    DateTime

  @@unique([source, subjectType, subjectValue])
  @@map("government_risk_records")
}

// ---------------------------------------------------------------------------
// Phase 2 AI — Persona Financial Assistant conversation history
// ---------------------------------------------------------------------------

enum AssistantMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AssistantThread {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_threads")
}

model AssistantMessage {
  id        String               @id @default(cuid())
  threadId  String
  thread    AssistantThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      AssistantMessageRole
  content   String               @db.Text
  createdAt DateTime             @default(now())

  @@index([threadId, createdAt])
  @@map("assistant_messages")
}
